# API Configuration
# Production: https://api.sokosumi.com
# Preprod: https://api.preprod.sokosumi.com
# Leave this unset for normal CLI usage.
# When a user pastes an API key in the CLI, it prefers production first and falls back to preprod automatically.
# SOKOSUMI_API_URL=https://api.sokosumi.com

# Optional overrides for browser-based auth handoff
# Web App default is derived from SOKOSUMI_API_URL (api.sokosumi.com -> app.sokosumi.com)
# Auth default is derived as <api>/auth
# SOKOSUMI_WEB_URL=https://app.sokosumi.com
# SOKOSUMI_AUTH_URL=https://api.sokosumi.com/auth

# Authentication
# Both API keys and auth tokens are sent as Bearer tokens per OpenAPI spec
# Option 1: API Key
# First-run CLI setup can store this automatically in ~/.sokosumi/config.json
# SOKOSUMI_API_KEY=<your-sokosumi-api-key>

# Option 2: Browser OAuth for the macOS TUI (same flow as sokosumi/apps/cli)
# Create a client at /developer/oauth-clients with this redirect URI:
# http://127.0.0.1:53682/oauth/callback
# Enable Sokosumi API (sokosumi:api) and offline access (offline_access).
# SOKOSUMI_OAUTH_CLIENT_ID=<public-oauth-client-id>
# SOKOSUMI_OAUTH_CLIENT_SECRET=<optional-client-secret>
# OAuth access and refresh tokens are stored in the macOS Keychain.

# Option 3: Auth token for headless commands
# SOKOSUMI_AUTH_TOKEN=your-auth-token-here

# Optional: Anthropic API Key for AI features
ANTHROPIC_API_KEY=<your-anthropic-api-key>
